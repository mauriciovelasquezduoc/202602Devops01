<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE module PUBLIC
    "-//Checkstyle//DTD Checkstyle Configuration 1.3//EN"
    "https://checkstyle.org/dtds/configuration_1_3.dtd">

<!--
    Checkstyle - convenciones de programación para ep02-app.

    Se usa un conjunto curado de reglas (no google_checks.xml) porque el
    proyecto usa indentación de 4 espacios y nombres de test descriptivos,
    incompatibles con las reglas por defecto de Google (2 espacios).

    Uso local:  ./gradlew checkstyleMain checkstyleTest
    Reporte:    build/reports/checkstyle/
-->
<module name="Checker">
    <property name="charset" value="UTF-8"/>
    <property name="severity" value="error"/>
    <property name="fileExtensions" value="java"/>

    <!-- Sin tabulaciones: la indentación es con espacios -->
    <module name="FileTabCharacter">
        <property name="eachLine" value="true"/>
    </module>

    <!-- El archivo debe terminar con salto de línea -->
    <module name="NewlineAtEndOfFile">
        <property name="lineSeparator" value="lf"/>
    </module>

    <!-- Sin espacios en blanco al final de línea -->
    <module name="RegexpSingleline">
        <property name="format" value="\s+$"/>
        <property name="message" value="La línea tiene espacios en blanco al final."/>
    </module>

    <module name="TreeWalker">
        <!-- ── Imports ──────────────────────────────────────────────── -->
        <!-- El orden de imports lo controla Spotless (importOrder). -->
        <module name="UnusedImports"/>
        <module name="RedundantImport"/>

        <!-- ── Nombres ──────────────────────────────────────────────── -->
        <module name="TypeName"/>
        <!-- Se permiten guiones bajos en nombres de test (metodo_escenario) -->
        <module name="MethodName">
            <property name="format" value="^[a-z][a-zA-Z0-9_]*$"/>
        </module>
        <module name="MemberName"/>
        <module name="ParameterName"/>
        <module name="LocalVariableName"/>
        <module name="ConstantName"/>
        <module name="StaticVariableName"/>
        <module name="PackageName"/>
        <module name="OuterTypeFilename"/>

        <!-- ── Correctitud básica ───────────────────────────────────── -->
        <module name="EqualsHashCode"/>
        <module name="SimplifyBooleanExpression"/>
        <module name="SimplifyBooleanReturn"/>
        <module name="EmptyStatement"/>
        <module name="OneStatementPerLine"/>
        <module name="UpperEll"/>
        <module name="ModifierOrder"/>
        <module name="RedundantModifier"/>
    </module>
</module>
